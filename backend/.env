# ==============================================================================

VECTOR_DB=qdrant

QDRANT_URL=https://b42ae5fc-8805-4c30-b378-0dbb5ca899ea.europe-west3-0.gcp.cloud.qdrant.io

QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6OTVjZDdlYTEtZWI3Mi00NmQ2LWIxNzUtMDAzZTlmNjJkNjA2In0.8_i5csuXvbso7kYWuSkn7NgdqdkNWyUR4e7sKJpUtKo

QDRANT_COLLECTION=apex_documents

