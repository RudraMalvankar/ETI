# ==============================================================================
# APEX — Environment Configuration
# ==============================================================================
# Copy this file to ".env"
# Never commit .env to Git.
#
# APEX
# Autonomous Process Execution Platform
# Industrial AI Decision Intelligence Platform
# ==============================================================================

# ==============================================================================
# APPLICATION
# ==============================================================================

APP_NAME=APEX
APP_VERSION=1.0.0

ENVIRONMENT=development          # development | staging | production
APP_MODE=demo                    # demo | live

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=pretty                # pretty | json

# ==============================================================================
# AI PROVIDERS
# ==============================================================================

# Supported:
# gemini
# nim

DEFAULT_LLM_PROVIDER=gemini
DEFAULT_EMBED_PROVIDER=nim
DEFAULT_OCR_PROVIDER=nim
DEFAULT_RERANK_PROVIDER=nim

# ==============================================================================
# GOOGLE GEMINI
# ==============================================================================

GEMINI_API_KEY=AIzaSyBrz6gkXAJ21p82FcDpycInBDX8y3SmNqU

# Free & Recommended
GEMINI_MODEL=gemini-2.5-flash

# Optional
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ==============================================================================
# NVIDIA NIM
# ==============================================================================

NIM_API_KEY=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
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------- FREE MODELS ----------

# Main Reasoning
NIM_REASONING_MODEL=meta/llama-3.1-70b-instruct

# OCR
NIM_OCR_MODEL=nemotron-ocr-v2

# Embeddings
NIM_EMBED_MODEL=llama-nemotron-embed-1b-v2

# Reranking
NIM_RERANK_MODEL=llama-nemotron-rerank-1b-v2

# ==============================================================================
